#include <glm/glm.hpp>
#include <vector>
#include <string>
#include <algorithm>
#include <cassert>
#include <cstdio>
#include "engine/physics/collision_retirement.h"
using pt::RetireCollisionOwners;
struct Piece{glm::mat4 file_transform{1};struct{bool valid=true;}cache;};
struct Stage{glm::mat4 file_to_world{1};bool walk_detail_surfaces=false;uint64_t id=1;};
struct Entry{const Stage*stage;std::string label;const Piece*piece;};
struct Owner{const Stage*stage;const Piece*piece;glm::mat4 transform{1};bool walk_detail=false;std::string label;uint64_t stage_id=1;uint32_t world=0,line=UINT32_MAX,reflection=UINT32_MAX;};
struct World{int retired=0;uint32_t OwnerCount()const{return 1;}void SetOwnerActive(uint32_t,bool active){if(!active)++retired;}};
int main(){Stage stage;Piece piece;World marker,other;World& world=marker;World* lines=nullptr;World* reflections=nullptr;
auto last_collision_world_=&world;auto last_line_world_=lines;auto last_reflection_world_=reflections;
std::vector<Entry> entries{{&stage,"hallway",&piece}};std::vector<Owner> collision_owners_{{&stage,&piece,glm::mat4(1),false,"hallway"}};
auto match=[&](){
const bool same_world=last_collision_world_==&world&&last_line_world_==lines&&last_reflection_world_==reflections;
const bool valid_owners=std::all_of(collision_owners_.begin(),collision_owners_.end(),[&](const auto& o){return o.world<world.OwnerCount();});
/* PRODUCTION_CONDITION */
return same;};
assert(match());stage.file_to_world[3].x=1;assert(!match());
piece.cache.valid=true;assert(!match());collision_owners_[0].transform=stage.file_to_world;assert(match());
piece.cache.valid=false;assert(!match());piece.cache.valid=true;
stage.walk_detail_surfaces=true;assert(!match());stage.walk_detail_surfaces=false;
entries[0].label="changed";assert(match());entries[0].label="hallway";
last_collision_world_=&other;assert(!match());last_collision_world_=&marker;assert(match());
stage.id=2;assert(!match());stage.id=1;
entries.clear();assert(match()&&collision_owners_.empty()&&world.retired==1);
puts("Production collision reuse/retirement passed: transforms, generation, invalidation, geometry-neutral renames, world identity and removed owners");}
